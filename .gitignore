# Ecosystem factory defaults (seeded; repo-owned after the first sync).
/Manifest*.toml
/docs/build/
/docs/Manifest*.toml
/test/Manifest*.toml
/test/jet/Manifest*.toml
/test/contracts/Manifest*.toml
/benchmark/Manifest*.toml
/scripts/test/fixtures/tdd/scratchpkg/Manifest*.toml
# lanes and agent scratch
/.worktrees/
/.lanes/
/.superpowers/
/.claude/worktrees/
/.claude/settings.local.json
# machine-local settings and what gen.jl renders from them (private paths are never committed)
/.agents/factory.local.toml
/.claude/hooks/read-only-roots.txt
# test and coverage output: never at the root
*.jl.cov
*.jl.*.cov
*.jl.mem
/lcov.info
/coverage/
/tmp/
# Supposition's counterexample database: every @check passes db=false, and a database written
# by a newer Julia crashes 1.10 ("Cannot read stream serialized with a newer version")
SuppositionDB/
.DS_Store
